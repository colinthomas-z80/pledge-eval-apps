{
  "define":{
	"num_data": 5
}
  "rules": [
    {
      "command": "/groups/dthain/users/cthoma26/annotations/pycbc/env/bin/python match_strain.py --input-file data/H1_strain_%d.hdf5 --channel H1 --output-file H1_5-10_%d.csv --template-range 8-12 --template-step 1.0",
      "outputs": [
        "H1_5-10_%d.csv"
      ],
      "inputs": [
        "data/H1_strain_%d.hdf5",
        "match_strain.py"
      ]
    },
    {
      "command": "/groups/dthain/users/cthoma26/annotations/pycbc/env/bin/python match_strain.py --input-file data/L1_strain_%d.hdf5 --channel L1 --output-file L1_5-10_%d.csv --template-range 8-12 --template-step 1.0",
      "outputs": [
        "L1_5-10_%d.csv"
      ],
      "inputs": [
        "data/L1_strain_%d.hdf5",
        "match_strain.py"
      ]
    },
    {
      "command": "/groups/dthain/users/cthoma26/annotations/pycbc/env/bin/python coincidence.py --h1-trig H1_5-10_%d.csv --l1-trig L1_5-10_1.csv --output-file 5-10_1_coincident_events.csv",
      "outputs": [
        "5-10_%d_coincident_events.csv"
      ],
      "inputs": [
        "H1_5-10_%d.csv",
        "L1_5-10_%d.csv",
        "coincidence.py"
      ]
    },
    {
      "command": "/groups/dthain/users/cthoma26/annotations/pycbc/env/bin/python make_inference.py --coincident-events 5-10_%d_coincident_events.csv --output-dir wf --name-pattern 5-10_1 --template-range 8-10 --template-step 1.0",
      "outputs": [],
      "inputs": [
        "5-10_%d_coincident_events.csv",
        "make_inference.py"
      ]
    }
  ]
}
