{
  "define":{
	"num_data": 5
  },
  "rules": [
    {
      "command": format("/groups/dthain/users/cthoma26/annotations/pycbc/env/bin/python match_strain.py --input-file data/H1_strain_%d.hdf5 --channel H1 --output-file H1_5-10_%d.csv --template-range 8-12 --template-step 1.0", idx, idx),
      "outputs": [
        format("H1_5-10_%d.csv", idx)
      ],
      "inputs": [
        format("data/H1_strain_%d.hdf5", idx),
        "match_strain.py"
      ]
    } for idx in range(1, num_data),
    {
      "command": format("/groups/dthain/users/cthoma26/annotations/pycbc/env/bin/python match_strain.py --input-file data/L1_strain_%d.hdf5 --channel L1 --output-file L1_5-10_%d.csv --template-range 8-12 --template-step 1.0", idx, idx),
      "outputs": [
        format("L1_5-10_%d.csv", idx)
      ],
      "inputs": [
        format("data/L1_strain_%d.hdf5", idx),
        "match_strain.py"
      ]
    } for idx in range(1, num_data),
    {
      "command": format("/groups/dthain/users/cthoma26/annotations/pycbc/env/bin/python coincidence.py --h1-trig H1_5-10_%d.csv --l1-trig L1_5-10_%d.csv --output-file 5-10_%d_coincident_events.csv", idx, idx,idx),
      "outputs": [
        format("5-10_%d_coincident_events.csv", idx)
      ],
      "inputs": [
        format("H1_5-10_%d.csv", idx),
        format("L1_5-10_%d.csv", idx),
        "coincidence.py"
      ]
    } for idx in range(1, num_data),
    {
      "command": format("/groups/dthain/users/cthoma26/annotations/pycbc/env/bin/python make_inference.py --coincident-events 5-10_%d_coincident_events.csv --output-dir wf --name-pattern 5-10_%d --template-range 8-10 --template-step 1.0", idx, idx),
      "outputs": [],
      "inputs": [
        format("5-10_%d_coincident_events.csv", idx),
        "make_inference.py"
      ]
    } for idx in range(1, num_data)
  ]
}
