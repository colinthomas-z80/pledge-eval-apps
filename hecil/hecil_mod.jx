        "query.fastq.9"
      ],
      "inputs": [
        "fastq_reduce",
        "query.fastq"
      ]
    },
    {
      "command": "./bwa index ref.fasta",
      "outputs": [
        "ref.fasta.amb",
        "ref.fasta.ann",
        "ref.fasta.bwt",
        "ref.fasta.pac",
        "ref.fasta.sa"
      ],
      "inputs": [
        "bwa",
        "ref.fasta"
      ]
    },
    {
      "command": "./samtools view -o View.bam -bS Out.sam",
      "outputs": [
        "View.bam"
      ],
      "inputs": [
        "Out.sam",
        "samtools"
      ]
    },
    {
      "command": "./samtools sort -o Out.bam View.bam",
      "outputs": [
        "Out.bam"
      ],
      "inputs": [
        "View.bam",
        "samtools"
      ]
    },
    {
