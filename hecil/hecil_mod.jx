{
  "rules": [
    {
      "command": "/usr/bin/perl fastq_reduce query.fastq 10",
      "outputs": [
        "query.fastq.0",
        "query.fastq.1",
        "query.fastq.2",
        "query.fastq.3",
        "query.fastq.4",
        "query.fastq.5",
        "query.fastq.6",
        "query.fastq.7",
