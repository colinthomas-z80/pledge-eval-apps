{
  "rules": [
    {
      "command": "/home/scuzee/Montage/bin/mHdr \"NGC 3372\" 2.0 region.hdr",
      "outputs": [
        "region.hdr"
      ],
      "inputs": []
    },
    {
      "command": "/home/scuzee/Montage/bin/mImgtbl raw_j rimages.tbl",
      "outputs": [
        "rimages.tbl"
      ],
      "inputs": [
       "raw_set"
      ]
    },
    {
      "command": "/home/scuzee/Montage/bin/mProjExec -q -p raw_j rimages.tbl region.hdr projected_j stats.tbl",
      "outputs": [
       "proj_set"
      ],
      "inputs": [
        "raw_set",
        "region.hdr",
        "rimages.tbl"
      ]
    },
    {
      "command": "/home/scuzee/Montage/bin/mImgtbl projected_j pimages.tbl",
      "outputs": [
        "pimages.tbl"
      ],
      "inputs": [
        "proj_set"
      ]
    },
    {
      "command": "/home/scuzee/Montage/bin/mOverlaps pimages.tbl diffs_j.tbl",
      "outputs": [
        "diffs_j.tbl"
      ],
      "inputs": [
        "pimages.tbl"
      ]
    },
    {
      "command": "/home/scuzee/Montage/bin/mDiffFitExec -p projected_j diffs_j.tbl region.hdr diffs_j fits_j.tbl",
      "outputs": [
        "fits_j.tbl"
      ],
      "inputs": [
        "diffs_j.tbl",
        "proj_set",
        "region.hdr"
      ]
    },
    {
      "command": "/home/scuzee/Montage/bin/mBgModel pimages.tbl fits_j.tbl corrections_j.tbl",
      "outputs": [
        "corrections_j.tbl"
      ],
      "inputs": [
        "fits_j.tbl",
        "pimages.tbl"
      ]
    },
    {
      "command": "/home/scuzee/Montage/bin/mBgExec -p projected_j pimages.tbl corrections_j.tbl corrected_j",
      "outputs": [
        "corr_set"
      ],
      "inputs": [
        "corrections_j.tbl",
        "pimages.tbl",
        "proj_set"
      ]
    },
    {
      "command": "/home/scuzee/Montage/bin/mImgtbl corrected_j cimages.tbl",
      "outputs": [
        "cimages.tbl"
      ],
      "inputs": [
        "corr_set"
      ]
    },
    {
      "command": "/home/scuzee/Montage/bin/mAdd -p corrected_j cimages.tbl region.hdr jband.fits",
      "outputs": [
        "jband.fits",
      ],
      "inputs": [
        "cimages.tbl",
        "corr_set",
        "region.hdr"
      ]
    },
    {
      "command": "/home/scuzee/Montage/bin/mShrink kband.fits ksmall.fits 5",
      "outputs": [
        "jsmall.fits"
      ],
      "inputs": [
        "jband.fits"
      ]
    },
    {
      "command": "/home/scuzee/Montage/bin/mViewer -ct 1 -gray ksmall.fits -2s max gaussian-log -out mosaic.png",
      "outputs": [

      ],
      "inputs": [
        "jsmall.fits"
      ]
    }
  ]
}
